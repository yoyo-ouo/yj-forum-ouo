# 妖精论坛 v2 前端服务（Next.js standalone）
# 安装: cp deploy/yj-web.service /etc/systemd/system/ && systemctl enable --now yj-web
[Unit]
Description=YJ Forum v2 Web (Next.js)
After=network.target yj-forum.service

[Service]
Type=simple
User=yoyo
WorkingDirectory=/opt/yj-forum/web
EnvironmentFile=/opt/yj-forum/web/.env
Environment=PORT=3000
ExecStart=/usr/bin/node /opt/yj-forum/web/.next/standalone/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
