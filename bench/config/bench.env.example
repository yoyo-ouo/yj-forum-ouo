# ============================================================
# 基准测试专用环境（仅 bench 使用）
# 启动脚本会用 env -i 只注入本文件的变量，绝不会读取 server/.env，
# 因此真实 SMTP 凭据与开发库连接串不会被带进来。
# ============================================================
APP_ENV=dev
HOST=127.0.0.1
PORT=8091
SECRET_KEY=bench-only-secret-key-please-do-not-use-in-prod

# 独立基准库（容器 ouo-postgres-bench，端口 5433）
DATABASE_URL=postgresql://postgres:localdev123@127.0.0.1:5433/yj_forum_bench
MIGRATE_ON_START=true

# 硬性关闭：基准跑分不允许发真实邮件
SMTP_ENABLED=false
RECEIVERALL=

CORS_ORIGINS=http://127.0.0.1:8091,http://localhost:8091

# 存储全部指向临时目录，避开真实媒体/头像
AVATAR_DIR=/tmp/yj-bench/avatar
DATA_DIR=/tmp/yj-bench/data
MEDIA_DIR=/tmp/yj-bench/media
S3_ENABLED=false

# 关闭人机验证；开启调试端点与限流旁路（生产会被强制关闭）
ALTCHA_ENABLED=false
BENCH_DEBUG=true
